// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String    @id @default(cuid())
  clerkUserId String    @unique
  email       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  resumes       Resume[]
  portfolio     Portfolio?
  notifications Notification[]

  @@index([clerkUserId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   // e.g., "engagement", "milestone", "system"
  icon      String   // e.g., "MousePointer2", "CheckCircle2", "TrendingUp"
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model Resume {
  id               String   @id @default(cuid())
  userId           String
  storageBucket    String
  storagePath      String
  originalFilename String?
  mimeType         String?
  sizeBytes        Int?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Portfolio {
  id                 String           @id @default(cuid())
  userId             String           @unique
  slug               String           @unique
  publishedVersionId String?          @unique
  isPublic           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions         PortfolioVersion[]
  publishedVersion PortfolioVersion? @relation("PublishedVersion", fields: [publishedVersionId], references: [id])
  analytics        AnalyticsVisit[]
  linkClicks       LinkClick[]

  @@index([slug])
}

model AnalyticsVisit {
  id          String   @id @default(cuid())
  portfolioId String
  viewerIp    String?  // Hashed or masked for privacy
  userAgent   String?
  referer     String?
  path            String   @default("/")
  createdAt       DateTime @default(now())
  durationSeconds Int      @default(0)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([createdAt])
}

model LinkClick {
  id          String   @id @default(cuid())
  portfolioId String
  linkType    String   // e.g. "email_cta", "email_header", "project_link", "social"
  linkUrl     String?
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([createdAt])
}

model PortfolioVersion {
  id          String   @id @default(cuid())
  portfolioId String
  data        Json
  createdAt   DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  publishedBy Portfolio? @relation("PublishedVersion")

  @@index([portfolioId])
}
